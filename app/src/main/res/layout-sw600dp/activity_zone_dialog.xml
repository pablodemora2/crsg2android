<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:gravity="center"
    android:paddingBottom="@dimen/activity_vertical_margin" 
              android:paddingLeft="@dimen/activity_horizontal_margin" 
              android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="center"
        android:background="@drawable/shape_black"
        android:orientation="vertical"
        android:paddingTop="@dimen/activity_vertical_margin">

        <Button
            android:id="@+id/btnGoToZone1"
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:onClick="goToZone1"
            android:padding="@dimen/activity_vertical_margin"
            android:text="@string/northpacific"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_title"/>

        <Button
            android:id="@+id/btnGoToZone2"
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:onClick="goToZone2"
            android:padding="@dimen/activity_vertical_margin"
            android:text="@string/centralpacific"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_title" />

        <Button
            android:id="@+id/btnGoToZone3"
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:onClick="goToZone3"
            android:padding="@dimen/activity_vertical_margin"
            android:text="@string/southpacific"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_title"/>

        <Button
            android:id="@+id/btnGoToZone4"
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:onClick="goToZone4"
            android:padding="@dimen/activity_vertical_margin"
            android:text="@string/southcaribbean"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_title"/>


    </LinearLayout>

</LinearLayout>