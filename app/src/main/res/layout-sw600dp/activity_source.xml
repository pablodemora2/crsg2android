<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:gravity="center"
    android:paddingBottom="14dp"
              android:paddingLeft="@dimen/activity_horizontal_margin"
              android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="14dp">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_gravity="center"
        android:background="@drawable/shape_black"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnSetSource1"
            android:text="@string/sanjose"
            android:onClick="SetSource1"
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:padding="14dp"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_title"

            />

        <Button
            android:id="@+id/btnSetSource2"
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:onClick="SetSource2"
            android:padding="14dp"
            android:text="@string/alajuelaairport"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_title"/>

        <Button
            android:id="@+id/btnSetSource3"
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:onClick="SetSource3"
            android:padding="14dp"
            android:text="@string/liberiaairport"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_title" />

        <Button
            android:id="@+id/btnSetSource4"
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:background="#00000000"
            android:onClick="SetSource4"
            android:padding="14dp"
            android:text="@string/mylocation"
            android:textColor="@color/white"
            android:textSize="@dimen/text_size_title" />


    </LinearLayout>

</LinearLayout>