<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">

        <ScrollView
            android:id="@+id/SCROLLER_ID"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtVwBeach"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:text="@string/beach"
                            android:textSize="@dimen/text_size_title"
                            android:textColor="@color/darkgrey" />

                        <TextView
                            android:id="@+id/txtVwBeach2"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:text="@string/beach"
                            android:textColor="@color/black_overlay"
                            android:textStyle="normal|italic"
                            android:textSize="@dimen/text_size" />

                        <TextView
                            android:id="@+id/txtVwLocation"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:text="@string/location"
                            android:textColor="@color/darkgrey"
                            android:textSize="@dimen/text_size_title" />

                        <TextView
                            android:id="@+id/txtVwLocation2"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:text="@string/location"
                            android:textColor="@color/black_overlay"
                            android:textStyle="normal|italic"
                            android:textSize="@dimen/text_size" />


                        <TextView
                            android:id="@+id/txtVwRating"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:text="@string/rating"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_title" />

                        <RatingBar
                            android:id="@+id/ratingBar1"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="fill_parent"
                            android:numStars="5" />

                        <TextView
                            android:id="@+id/txtVwDangers"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:text="@string/dangers"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_title" />

                        <TextView
                            android:id="@+id/txtVwDangers2"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:text="@string/dangers"
                            android:textColor="@color/black_overlay"
                            android:textStyle="normal|italic"
                            android:textSize="@dimen/text_size" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                            <ImageView
                            android:id="@+id/imageView9"
                            android:layout_width="175dp"
                            android:layout_height="175dp"
                            android:adjustViewBounds="true"
                            android:background="@drawable/shape_photo_black"
                            android:contentDescription="@string/empty"
                            android:src="@drawable/im_bejuco" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtVwBestSwell"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:text="@string/best_swell_dirrection"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_title" />

                        <TextView
                            android:id="@+id/txtVwBestSwell2"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:text="@string/best_swell_dirrection"
                            android:textColor="@color/black_overlay"
                            android:textStyle="normal|italic"
                            android:textSize="@dimen/text_size" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtVwBestTide"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:text="@string/best_tide_position"
                            android:textColor="@color/black"
                            android:textSize="@dimen/text_size_title" />

                        <TextView
                            android:id="@+id/txtVwBestTide2"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent"
                            android:text="@string/best_tide_position"
                            android:textColor="@color/black_overlay"
                            android:textStyle="normal|italic"
                            android:textSize="@dimen/text_size" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtVwDescription"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:text="@string/beachandwavedescription"
                    android:textColor="@color/black"
                    android:textSize="@dimen/text_size_title" />

                <TextView
                    android:id="@+id/txtVwDescription2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="100000"
                    android:scrollbars="vertical"
                    android:text="@string/description"
                    android:textColor="@color/black_overlay"
                    android:textSize="@dimen/text_size" />

                <TextView
                    android:id="@+id/textViewDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fadeScrollbars="true"
                    android:fadingEdge="vertical"
                    android:maxLines="5"
                    android:scrollbarStyle="insideOverlay"
                    android:scrollbars="vertical"
                    android:text="@string/empty"
                    android:textColor="@color/darkgrey"
                    android:textStyle="normal|italic"
                    android:textSize="@dimen/text_size" />
            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</LinearLayout>